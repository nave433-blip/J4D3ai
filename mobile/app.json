{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#08081a",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.nave433.jade",
      "permissions": [
        "INTERNET"
      ]
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.nave433.jade",
      "supportsTablet": true
    },
    "name": "Jade",
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#08081a"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Jade uses the microphone so you can dictate chat messages instead of typing.",
          "speechRecognitionPermission": "Jade uses speech recognition to turn your voice into text for chat messages."
        }
      ]
    ],
    "scheme": "jade",
    "slug": "jade",
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
