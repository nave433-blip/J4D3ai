# Copy to .env and fill in. NEVER commit .env.
#   cp .env.example .env

# --- server ---
JADE_SERVER_HOST=0.0.0.0
JADE_SERVER_PORT=8080
JADE_DATA_DIR=/data
# Public URL of this server (used to build OAuth redirect URIs).
JADE_PUBLIC_URL=http://localhost:8080

# --- token encryption (REQUIRED for connector storage) ---
# Generate:  openssl rand -base64 32
JADE_TOKEN_KEY=

# --- database (reference impl uses sqlite; leave unset) ---
# DATABASE_URL=postgresql://jade:secret@db:54360/jade

# --- hosted chat (OpenAI-compatible /v1/chat/completions) ---
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, Groq, Together...).
JADE_CHAT_PROVIDER=openai
JADE_CHAT_BASE_URL=https://api.openai.com/v1
JADE_CHAT_API_KEY=
JADE_CHAT_MODEL=gpt-4o-mini

# --- OAuth apps (ONE registration per provider, held by the server) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple Sign In needs a Services ID + signed client_secret (see server/README.md).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PEM=

# --- tuning ---
JADE_SESSION_TTL=2592000
JADE_PAIRING_TTL=600
JADE_RATE_LIMIT=120

# --- compose-only (postgres/redis for the production path) ---
POSTGRES_USER=jade
POSTGRES_PASSWORD=change-me-in-.env
POSTGRES_DB=jade
REDIS_PASSWORD=change-me-in-.env
